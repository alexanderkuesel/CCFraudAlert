# --- Database (PostgreSQL) ---
# Used when running the CLI on the host. Under docker compose, the containers ignore this and use db:5432.
# Port 5433 = the compose database as published on the host; use 5432 for your own local Postgres.
FRAUDALERT_DATABASE_URL=postgresql+psycopg://fraudalert:fraudalert@localhost:5433/fraudalert
# Host ports docker compose publishes (change if something else already uses them)
FRAUDALERT_DB_HOST_PORT=5433
FRAUDALERT_WEB_HOST_PORT=8000

# --- Inbox (IMAP). For Gmail: enable 2FA and create an App Password. ---
FRAUDALERT_IMAP_HOST=imap.gmail.com
FRAUDALERT_IMAP_PORT=993
FRAUDALERT_IMAP_USER=you@gmail.com
FRAUDALERT_IMAP_PASSWORD=your-app-password
FRAUDALERT_IMAP_FOLDER=INBOX
# Only look at mail from these senders (comma separated, substring match on From header)
FRAUDALERT_SENDER_FILTER=no.reply.alerts@chase.com
# Only look at mail whose subject contains one of these (comma separated, optional)
FRAUDALERT_SUBJECT_FILTER=
# How far back to look on the first sync
FRAUDALERT_LOOKBACK_DAYS=90

# --- Behaviour ---
FRAUDALERT_HOME_CURRENCY=USD
FRAUDALERT_TIMEZONE=America/New_York
# Anomaly detector implementation (see fraudalert/anomaly/base.py)
FRAUDALERT_DETECTOR=baseline
# Optional: POST a JSON payload here whenever a transaction is flagged (Slack/ntfy/Discord/etc.)
FRAUDALERT_NOTIFY_WEBHOOK_URL=

# --- Web UI access ---
# 127.0.0.1 = this machine only. 0.0.0.0 = any computer on your network (docker compose),
# which requires the username/password below; the app won't start without them.
FRAUDALERT_WEB_BIND=127.0.0.1
FRAUDALERT_WEB_USERNAME=
FRAUDALERT_WEB_PASSWORD=
